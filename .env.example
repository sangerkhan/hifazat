# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Assessment engine (required)
# ---------------------------------------------------------------------------
# Google AI Studio key. Without it the app still works, but every assessment
# falls back to the offline keyword responses in app/api/assess/route.ts.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Lawyer referrals — see docs/REFERRALS.md
# ---------------------------------------------------------------------------
# Configure at least ONE destination. With none configured, /api/refer returns
# 503 and the form tells the person their case was not passed on, rather than
# claiming success and dropping it. In development it prints to the console
# instead, so the flow can be exercised without credentials.

# Google Apps Script Web App URL (ends in /exec)
GOOGLE_SHEETS_WEBHOOK_URL=
# Must match the SECRET constant in the Apps Script. Without it, anyone holding
# the URL can write rows into the legal desk's queue.
GOOGLE_SHEETS_SHARED_SECRET=

# Email notification via Resend. The sending domain must be verified there.
RESEND_API_KEY=
# Comma-separated
REFERRAL_EMAIL_TO=
REFERRAL_EMAIL_FROM=Hifazat <referrals@hifazat.app>
