# Copy to .env.local and fill in. Never commit .env.local.
#
# Every variable in this file is a server secret. NONE of them may be given a
# NEXT_PUBLIC_ prefix: Next inlines those into the JavaScript every visitor
# downloads, so the prefix turns a secret into a published one. There are no
# NEXT_PUBLIC_ variables in this app and there is no reason to add one — the
# browser talks only to this app's own route handlers, which hold the keys
# server-side.
#
# Two guards enforce that, both verified to fail on purpose:
#   - Modules that read these are marked `import "server-only"`, so importing
#     one from a client component fails the build.
#   - `npm run check:secrets` (also `postbuild`, so it runs on Vercel) scans
#     the built browser bundle for secret names and credential shapes.

# ---------------------------------------------------------------------------
# Assessment engine (required)
# ---------------------------------------------------------------------------
# Google AI Studio key. Without it the app still works, but every assessment
# falls back to the offline keyword responses in app/api/assess/route.ts —
# generic text matched on a few words, not an assessment of what was written.
#
# To check a deployment is really using the model rather than that fallback:
#   curl https://<your-host>/api/assess
# It sends a one-token request and reports {"ok":true,...}, or names the cause
# (no_api_key / rejected / empty_response / unreachable). Users see a notice on
# the result screen whenever they got the fallback, so this should never be a
# silent condition again.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Supabase backend — see docs/BACKEND.md
# ---------------------------------------------------------------------------
# Optional. Without these the app runs on the datasets bundled in lib/, exactly
# as it does today. With them, reference data and the answer cache come from the
# database, so verifying a helpline no longer needs a deploy.
SUPABASE_URL=
# Server-side only. Bypasses row level security — never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# How long reference data is held in memory before refetching. Default 300000.
REFERENCE_CACHE_TTL_MS=

# ---------------------------------------------------------------------------
# Admin tools (/admin)
# ---------------------------------------------------------------------------
# Optional, but the verification and review workflows are unusable without it.
# With this unset the whole /admin section returns 404 — not a login page — so
# an unconfigured deploy cannot ship an open door.
#
# These screens show names and phone numbers of people who may be in danger.
# Use a long random password and share it only with the legal desk.
# Minimum 12 characters, or it is treated as unconfigured.
ADMIN_PASSWORD=
# Optional. Session cookies are signed with this. Left unset, it is derived from
# ADMIN_PASSWORD, which means changing the password signs everyone out.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Lawyer referrals — see docs/REFERRALS.md
# ---------------------------------------------------------------------------
# Configure at least ONE destination. With none configured, /api/refer returns
# 503 and the form tells the person their case was not passed on, rather than
# claiming success and dropping it. In development it prints to the console
# instead, so the flow can be exercised without credentials.

# Google Apps Script Web App URL (ends in /exec)
GOOGLE_SHEETS_WEBHOOK_URL=
# Must match the SECRET constant in the Apps Script. Without it, anyone holding
# the URL can write rows into the legal desk's queue.
GOOGLE_SHEETS_SHARED_SECRET=

# Email notification via Resend. The sending domain must be verified there.
RESEND_API_KEY=
# Comma-separated
REFERRAL_EMAIL_TO=
REFERRAL_EMAIL_FROM=Hifazat <referrals@hifazat.app>
